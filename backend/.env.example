# ==============================================================================
# TraceX Legal Metrology Platform - Backend Environment Variables
# Project [TraceX] (SIH26034) - Department of Consumer Affairs (DoCA)
# ==============================================================================

# Database Configuration
# Leave blank or unset to use local SQLite (tracex.db).
# On Render / Neon / Supabase, set to your PostgreSQL connection string:
# postgresql://user:password@host:port/database
DATABASE_URL=

# Frontend Origin for CORS
# Set to your production Vercel frontend URL (e.g. https://tracex.vercel.app)
# Comma-separated if multiple domains are used.
FRONTEND_URL=

# Web Server Port (Render automatically sets $PORT)
PORT=8000

# Cryptographic Root Signing Key (Optional)
# If set, this RSA-2048 PEM key will be used for all legal notice digital signatures.
# If unset, TraceX generates and saves an RSA keypair locally to keys/private_key.pem.
# RSA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Vision-LLM API Configuration
# Add your Gemini API key to enable live cloud OCR on arbitrary brand packaging photos:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional fallback to OpenAI Vision:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# SMTP Email Delivery Configuration (for Official Show-Cause Notices)
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=notices@consumerhelpline.gov.in
